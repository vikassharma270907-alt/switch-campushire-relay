{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "laya": {
      "command": "D:\\switch wemakedev hackathon\\laya-repo\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "laya.mcp.server"
      ],
      "env": {
        "LAYA_DEVICE": "cpu",
        "LAYA_PRELOAD": "0",
        "LAYA_THREADS": "8"
      }
    },
    "skillspector": {
      "command": "C:\\Users\\vikas sharma\\AppData\\Roaming\\uv\\tools\\skillspector\\Scripts\\python.exe",
      "args": [
        "-m",
        "skillspector.cli",
        "mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    }
  }
}
